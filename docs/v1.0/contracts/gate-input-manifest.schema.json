{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdlc.dev/contracts/v1alpha1/gate-input-manifest.schema.json",
  "title": "GateInputManifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "api_version",
    "manifest_id",
    "gate_id",
    "gate_set",
    "revision_vector",
    "parser_digest",
    "toolchain_digests",
    "selected_inputs",
    "selection_rule_hash",
    "input_digest"
  ],
  "properties": {
    "api_version": {
      "const": "sdlc.dev/gate-input-manifest/v1alpha1"
    },
    "manifest_id": {
      "type": "string",
      "pattern": "^GINPUT-[A-Za-z0-9._-]+$"
    },
    "gate_id": {
      "type": "string",
      "minLength": 1
    },
    "gate_set": {
      "enum": ["slice", "review_entry", "acceptance", "delivery"]
    },
    "revision_vector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "facts_revision",
        "workspace_revision",
        "framework_pack_digest",
        "policy_digest",
        "environment_binding_digest"
      ],
      "properties": {
        "facts_revision": {
          "$ref": "#/$defs/sha256"
        },
        "workspace_revision": {
          "$ref": "#/$defs/sha256"
        },
        "framework_pack_digest": {
          "$ref": "#/$defs/sha256"
        },
        "policy_digest": {
          "$ref": "#/$defs/sha256"
        },
        "environment_binding_digest": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "parser_digest": {
      "$ref": "#/$defs/sha256"
    },
    "toolchain_digests": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/sha256"
      }
    },
    "selected_inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "identity", "digest", "selection_source"],
        "properties": {
          "kind": {
            "enum": ["workspace_path", "fact", "binding", "configuration"]
          },
          "identity": {
            "type": "string",
            "minLength": 1
          },
          "digest": {
            "$ref": "#/$defs/sha256"
          },
          "selection_source": {
            "enum": ["pack", "project_profile", "policy", "core_mandatory"]
          }
        }
      }
    },
    "selection_rule_hash": {
      "$ref": "#/$defs/sha256"
    },
    "input_digest": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
