{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdlc.dev/contracts/v1alpha1/delivery-manifest.schema.json",
  "title": "DeliveryManifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "delivery_id",
    "task_id",
    "base_revision",
    "workspace_revision",
    "source_manifest_ref",
    "source_bundle_ref",
    "facts_revision_before",
    "facts_revision_after",
    "mandatory_gate_runs",
    "framework_pack_digest",
    "policy_digest",
    "environment_binding_digest",
    "toolchain_digests",
    "receipt_refs",
    "changed_paths",
    "rollback_strategy",
    "manifest_digest"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "delivery_id": {
      "type": "string",
      "pattern": "^DELIVERY-[A-Za-z0-9._-]+$"
    },
    "task_id": {
      "type": "string",
      "pattern": "^TASK-[A-Za-z0-9._-]+$"
    },
    "base_revision": {
      "type": "string",
      "minLength": 1
    },
    "workspace_revision": {
      "$ref": "#/$defs/sha256"
    },
    "source_manifest_ref": {
      "$ref": "#/$defs/artifactRef"
    },
    "source_bundle_ref": {
      "$ref": "#/$defs/artifactRef"
    },
    "facts_revision_before": {
      "$ref": "#/$defs/sha256"
    },
    "facts_revision_after": {
      "$ref": "#/$defs/sha256"
    },
    "mandatory_gate_runs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["gate_id", "gate_set", "input_digest", "evidence_refs"],
        "properties": {
          "gate_id": {"type": "string", "minLength": 1},
          "gate_set": {"enum": ["slice", "review_entry", "acceptance", "delivery"]},
          "input_digest": {"$ref": "#/$defs/sha256"},
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "items": {"$ref": "#/$defs/artifactRef"}
          }
        }
      }
    },
    "framework_pack_digest": {
      "$ref": "#/$defs/sha256"
    },
    "policy_digest": {
      "$ref": "#/$defs/sha256"
    },
    "environment_binding_digest": {
      "$ref": "#/$defs/sha256"
    },
    "toolchain_digests": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/sha256"
      }
    },
    "receipt_refs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["spec", "review", "delivery"],
      "properties": {
        "spec": {"$ref": "#/$defs/artifactRef"},
        "review": {"$ref": "#/$defs/artifactRef"},
        "delivery": {"$ref": "#/$defs/artifactRef"}
      }
    },
    "changed_paths": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/path"}
    },
    "rollback_strategy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "instructions_ref", "automatic"],
      "properties": {
        "mode": {"enum": ["discard_isolated_workspace", "apply_source_bundle", "manual"]},
        "instructions_ref": {"$ref": "#/$defs/artifactRef"},
        "automatic": {"type": "boolean"}
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "automatic": {"const": true}
            },
            "required": ["automatic"]
          },
          "then": {
            "properties": {
              "mode": {"const": "discard_isolated_workspace"}
            }
          }
        }
      ]
    },
    "manifest_digest": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "path": {
      "type": "string",
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\\\u0000]+$"
    },
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "hash"],
      "properties": {
        "ref": {"type": "string", "pattern": "^sdlc://"},
        "hash": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
