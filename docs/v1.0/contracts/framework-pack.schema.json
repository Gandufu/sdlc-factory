{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdlc.factory/contracts/v1/framework-pack.schema.json",
  "title": "FrameworkPackDescriptor",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "moduleRoles",
    "capabilities"
  ],
  "properties": {
    "apiVersion": {
      "const": "sdlc.factory/v1"
    },
    "kind": {
      "const": "FrameworkPack"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "name"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,63}$"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "moduleRoles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "frontend",
          "backend",
          "desktop",
          "shared",
          "test_support",
          "other"
        ]
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "summary"
        ],
        "properties": {
          "name": {
            "enum": [
              "project.inspect",
              "dependencies.restore",
              "code.check",
              "build.compile",
              "package.build",
              "app.start",
              "app.ready",
              "app.stop",
              "test.run"
            ]
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "testKinds": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "unit",
                "integration",
                "functional"
              ]
            }
          }
        }
      }
    }
  }
}
