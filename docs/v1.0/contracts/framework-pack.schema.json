{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdlc.dev/contracts/v1alpha1/framework-pack.schema.json",
  "title": "FrameworkPack",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "compatibility",
    "requires",
    "paths",
    "capabilities"
  ],
  "properties": {
    "apiVersion": {
      "const": "sdlc.dev/framework-pack/v1alpha1"
    },
    "kind": {
      "const": "FrameworkPack"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "digest"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9.-]+$"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
        },
        "digest": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["core", "supportedOs", "supportedArch"],
      "properties": {
        "core": {
          "type": "string",
          "minLength": 1
        },
        "supportedOs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["windows", "linux", "macos"]
          }
        },
        "supportedArch": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["x64", "arm64"]
          }
        }
      }
    },
    "requires": {
      "type": "object",
      "additionalProperties": false,
      "required": ["packs", "toolchains"],
      "properties": {
        "packs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "version_range"],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9.-]+$"
              },
              "version_range": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "toolchains": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "version", "resolver"],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9.-]+$"
              },
              "version": {
                "type": "string",
                "minLength": 1
              },
              "resolver": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "paths": {
      "type": "object",
      "additionalProperties": false,
      "required": ["writable", "protected"],
      "properties": {
        "writable": {
          "$ref": "#/$defs/pathPatterns"
        },
        "protected": {
          "$ref": "#/$defs/pathPatterns"
        }
      }
    },
    "capabilities": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/capability"
      },
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9]*(?:\\.[a-z][a-z0-9]*)+$"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "pathPatterns": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runner",
        "argv",
        "cwd",
        "timeoutSeconds",
        "resultParser",
        "blocking",
        "requiredEnvironment",
        "requiredSecretRefs",
        "networkPolicy",
        "resourceLimits",
        "inputs",
        "outputs",
        "readiness",
        "cleanup",
        "invalidationInputs"
      ],
      "properties": {
        "runner": {
          "const": "process"
        },
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "cwd": {
          "type": "string",
          "minLength": 1
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        },
        "resultParser": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "version", "digest"],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "digest": {
              "$ref": "#/$defs/sha256"
            }
          }
        },
        "blocking": {
          "type": "boolean"
        },
        "requiredEnvironment": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "requiredSecretRefs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^secret://"
          }
        },
        "networkPolicy": {
          "enum": ["none", "declared_endpoints", "unrestricted"]
        },
        "resourceLimits": {
          "$ref": "#/$defs/resourceLimits"
        },
        "inputs": {
          "type": "object",
          "additionalProperties": false,
          "required": ["paths"],
          "properties": {
            "paths": {
              "$ref": "#/$defs/pathPatterns"
            }
          }
        },
        "outputs": {
          "type": "object",
          "additionalProperties": false,
          "required": ["paths", "evidenceTypes"],
          "properties": {
            "paths": {
              "$ref": "#/$defs/pathPatterns"
            },
            "evidenceTypes": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "readiness": {
          "oneOf": [
            {
              "$ref": "#/$defs/lifecycleStep"
            },
            {
              "type": "null"
            }
          ]
        },
        "cleanup": {
          "oneOf": [
            {
              "$ref": "#/$defs/lifecycleStep"
            },
            {
              "type": "null"
            }
          ]
        },
        "invalidationInputs": {
          "type": "object",
          "additionalProperties": false,
          "required": ["paths", "facts", "bindings"],
          "properties": {
            "paths": {
              "$ref": "#/$defs/pathPatterns"
            },
            "facts": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "bindings": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "enum": [
                  "environment_binding_digest",
                  "framework_pack_digest",
                  "policy_digest"
                ]
              }
            }
          }
        }
      }
    },
    "resourceLimits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cpuPercent",
        "memoryBytes",
        "diskBytes",
        "processCount",
        "logBytes"
      ],
      "properties": {
        "cpuPercent": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "memoryBytes": {
          "type": "integer",
          "minimum": 1
        },
        "diskBytes": {
          "type": "integer",
          "minimum": 1
        },
        "processCount": {
          "type": "integer",
          "minimum": 1
        },
        "logBytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "lifecycleStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "timeoutSeconds", "parameters"],
      "properties": {
        "type": {
          "enum": ["http", "tcp", "process", "file", "capability"]
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        },
        "parameters": {
          "type": "object"
        }
      }
    }
  }
}
