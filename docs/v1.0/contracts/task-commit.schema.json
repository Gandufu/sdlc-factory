{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdlc.dev/contracts/v1alpha1/task-commit.schema.json",
  "title": "TaskCommit",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "commit_id",
    "project_ref",
    "task_id",
    "expected_task_version",
    "action",
    "idempotency",
    "domain_events",
    "result",
    "artifact_refs",
    "transaction"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "commit_id": {
      "type": "string",
      "pattern": "^COMMIT-[A-Za-z0-9._-]+$"
    },
    "project_ref": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "pattern": "^TASK-[A-Za-z0-9._-]+$"
    },
    "expected_task_version": {
      "type": "integer",
      "minimum": 0
    },
    "action": {
      "type": "string",
      "minLength": 1
    },
    "idempotency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "request_hash"],
      "properties": {
        "key": {
          "type": "string",
          "minLength": 8
        },
        "request_hash": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "domain_events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["event_id", "event_type", "payload_ref", "payload_hash"],
        "properties": {
          "event_id": {
            "type": "string",
            "minLength": 1
          },
          "event_type": {
            "type": "string",
            "minLength": 1
          },
          "payload_ref": {
            "$ref": "#/$defs/sdlcRef"
          },
          "payload_hash": {
            "$ref": "#/$defs/sha256"
          }
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["result_ref", "result_hash", "summary"],
      "properties": {
        "result_ref": {
          "$ref": "#/$defs/sdlcRef"
        },
        "result_hash": {
          "$ref": "#/$defs/sha256"
        },
        "summary": {
          "type": "string",
          "maxLength": 500
        }
      }
    },
    "artifact_refs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/artifactRef"
      }
    },
    "transaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["transaction_id", "trace_id", "correlation_id", "created_at"],
      "properties": {
        "transaction_id": {
          "type": "string",
          "pattern": "^TXN-[A-Za-z0-9._-]+$"
        },
        "trace_id": {
          "type": "string",
          "minLength": 1
        },
        "correlation_id": {
          "type": "string",
          "minLength": 1
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "sdlcRef": {
      "type": "string",
      "pattern": "^sdlc://"
    },
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "ref", "hash"],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "ref": {
          "$ref": "#/$defs/sdlcRef"
        },
        "hash": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  }
}
