{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdlc.factory/contracts/v1/core-tool-request.schema.json",
  "title": "CoreAgentToolRequest",
  "oneOf": [
    {
      "$ref": "#/$defs/statusRequest"
    },
    {
      "$ref": "#/$defs/transitionRequest"
    },
    {
      "$ref": "#/$defs/executeRequest"
    },
    {
      "$ref": "#/$defs/operationGetRequest"
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "requestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "statusRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "apiVersion",
        "tool",
        "requestId",
        "query"
      ],
      "properties": {
        "apiVersion": {
          "const": "sdlc.factory/v1"
        },
        "tool": {
          "const": "sdlc_status"
        },
        "requestId": {
          "$ref": "#/$defs/requestId"
        },
        "query": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "enum": [
                "project",
                "work_item",
                "test_batch",
                "operation"
              ]
            },
            "id": {
              "$ref": "#/$defs/id"
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "kind": {
                    "enum": [
                      "work_item",
                      "test_batch",
                      "operation"
                    ]
                  }
                }
              },
              "then": {
                "required": [
                  "id"
                ]
              }
            }
          ]
        }
      }
    },
    "transitionRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "apiVersion",
        "tool",
        "requestId",
        "expectedVersion",
        "action",
        "arguments"
      ],
      "properties": {
        "apiVersion": {
          "const": "sdlc.factory/v1"
        },
        "tool": {
          "const": "sdlc_transition"
        },
        "requestId": {
          "$ref": "#/$defs/requestId"
        },
        "expectedVersion": {
          "type": "integer",
          "minimum": 0
        },
        "action": {
          "enum": [
            "work_item.create",
            "requirement.update",
            "implementation.start",
            "implementation.complete",
            "review.submit",
            "test_batch.create",
            "test_batch.cancel"
          ]
        },
        "subjectId": {
          "$ref": "#/$defs/id"
        },
        "arguments": {
          "type": "object"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "action": {
                "const": "work_item.create"
              }
            }
          },
          "then": {
            "properties": {
              "arguments": {
                "$ref": "#/$defs/createWorkItemArguments"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "requirement.update"
              }
            }
          },
          "then": {
            "required": [
              "subjectId"
            ],
            "properties": {
              "arguments": {
                "$ref": "#/$defs/updateRequirementArguments"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "enum": [
                  "implementation.start",
                  "review.submit"
                ]
              }
            }
          },
          "then": {
            "required": [
              "subjectId"
            ],
            "properties": {
              "arguments": {
                "$ref": "#/$defs/emptyArguments"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "implementation.complete"
              }
            }
          },
          "then": {
            "required": [
              "subjectId"
            ],
            "properties": {
              "arguments": {
                "$ref": "#/$defs/completeImplementationArguments"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "test_batch.create"
              }
            }
          },
          "then": {
            "properties": {
              "arguments": {
                "$ref": "#/$defs/createTestBatchArguments"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "test_batch.cancel"
              }
            }
          },
          "then": {
            "required": [
              "subjectId"
            ],
            "properties": {
              "arguments": {
                "$ref": "#/$defs/cancelTestBatchArguments"
              }
            }
          }
        }
      ]
    },
    "createWorkItemArguments": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "contentRef",
        "contentHash"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "contentRef": {
          "type": "string",
          "minLength": 1
        },
        "contentHash": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "updateRequirementArguments": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nextVersion",
        "contentRef",
        "contentHash"
      ],
      "properties": {
        "nextVersion": {
          "type": "integer",
          "minimum": 1
        },
        "contentRef": {
          "type": "string",
          "minLength": 1
        },
        "contentHash": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "emptyArguments": {
      "type": "object",
      "maxProperties": 0
    },
    "completeImplementationArguments": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceRevision"
      ],
      "properties": {
        "sourceRevision": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "createTestBatchArguments": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "planRef",
        "planHash",
        "workItemIds"
      ],
      "properties": {
        "planRef": {
          "type": "string",
          "minLength": 1
        },
        "planHash": {
          "$ref": "#/$defs/sha256"
        },
        "workItemIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        }
      }
    },
    "cancelTestBatchArguments": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reason"
      ],
      "properties": {
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "executeRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "apiVersion",
        "tool",
        "requestId",
        "expectedVersion",
        "capability"
      ],
      "properties": {
        "apiVersion": {
          "const": "sdlc.factory/v1"
        },
        "tool": {
          "const": "sdlc_execute"
        },
        "requestId": {
          "$ref": "#/$defs/requestId"
        },
        "expectedVersion": {
          "type": "integer",
          "minimum": 0
        },
        "capability": {
          "enum": [
            "project.inspect",
            "project.check",
            "project.build",
            "project.start",
            "project.stop",
            "project.test",
            "project.package"
          ]
        },
        "testBatchId": {
          "$ref": "#/$defs/id"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "capability": {
                "const": "project.test"
              }
            }
          },
          "then": {
            "required": [
              "testBatchId"
            ]
          }
        }
      ]
    },
    "operationGetRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "apiVersion",
        "tool",
        "requestId",
        "operationId"
      ],
      "properties": {
        "apiVersion": {
          "const": "sdlc.factory/v1"
        },
        "tool": {
          "const": "sdlc_operation_get"
        },
        "requestId": {
          "$ref": "#/$defs/requestId"
        },
        "operationId": {
          "$ref": "#/$defs/id"
        }
      }
    }
  }
}
