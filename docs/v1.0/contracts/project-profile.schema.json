{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdlc.factory/contracts/v1/project-profile.schema.json",
  "title": "ProjectProfile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "modules",
    "actions"
  ],
  "properties": {
    "apiVersion": {
      "const": "sdlc.factory/v1"
    },
    "kind": {
      "const": "ProjectProfile"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projectId",
        "name",
        "profileVersion"
      ],
      "properties": {
        "projectId": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "profileVersion": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "modules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/module"
      }
    },
    "actions": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "patternProperties": {
        "^project\\.(inspect|check|build|start|stop|test|package)$": {
          "$ref": "#/$defs/action"
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,63}$"
    },
    "capability": {
      "enum": [
        "project.inspect",
        "dependencies.restore",
        "code.check",
        "build.compile",
        "package.build",
        "app.start",
        "app.ready",
        "app.stop",
        "test.run"
      ]
    },
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "role",
        "root",
        "packRef"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "role": {
          "enum": [
            "frontend",
            "backend",
            "desktop",
            "shared",
            "test_support",
            "other"
          ]
        },
        "root": {
          "type": "string",
          "minLength": 1
        },
        "packRef": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9._-]*@[A-Za-z0-9][A-Za-z0-9._-]*$"
        }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "steps"
      ],
      "properties": {
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "moduleId",
              "capability"
            ],
            "properties": {
              "moduleId": {
                "$ref": "#/$defs/id"
              },
              "capability": {
                "$ref": "#/$defs/capability"
              },
              "inputs": {
                "type": "object"
              }
            }
          }
        }
      }
    }
  }
}
