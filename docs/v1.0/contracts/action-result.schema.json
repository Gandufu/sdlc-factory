{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdlc.dev/contracts/v1alpha1/action-result.schema.json",
  "title": "ActionResult",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "api_version",
    "action_id",
    "outcome",
    "trace_id",
    "correlation_id",
    "task_version",
    "operation_id",
    "result_ref",
    "error_ref"
  ],
  "properties": {
    "api_version": {
      "const": "sdlc.dev/action-result/v1alpha1"
    },
    "action_id": {
      "type": "string",
      "pattern": "^ACT-[A-Za-z0-9._-]+$"
    },
    "outcome": {
      "enum": ["accepted", "completed", "rejected"]
    },
    "trace_id": {
      "type": "string",
      "minLength": 1
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1
    },
    "task_version": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "operation_id": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^OP-[A-Za-z0-9._-]+$"
        },
        {
          "type": "null"
        }
      ]
    },
    "result_ref": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^sdlc://"
        },
        {
          "type": "null"
        }
      ]
    },
    "error_ref": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^sdlc://"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "rejected"
          }
        },
        "required": ["outcome"]
      },
      "then": {
        "properties": {
          "error_ref": {
            "type": "string",
            "pattern": "^sdlc://"
          }
        }
      },
      "else": {
        "properties": {
          "error_ref": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "accepted"
          }
        },
        "required": ["outcome"]
      },
      "then": {
        "properties": {
          "operation_id": {
            "type": "string",
            "pattern": "^OP-[A-Za-z0-9._-]+$"
          }
        }
      }
    }
  ]
}
