{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdlc.dev/contracts/v1alpha1/interface-catalog.schema.json",
  "title": "InterfaceCatalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "ownership", "interfaces"],
  "properties": {
    "apiVersion": {
      "const": "sdlc.dev/interface-catalog/v1alpha1"
    },
    "ownership": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "changePath"],
      "properties": {
        "owner": {
          "const": "ProjectFacts"
        },
        "changePath": {
          "const": "fact_change_set_delivery"
        }
      }
    },
    "interfaces": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/interface"
      }
    }
  },
  "$defs": {
    "interface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "classification",
        "direction",
        "owningModule",
        "provider",
        "consumer",
        "protocol",
        "contractVersion",
        "contractRef",
        "authenticationMode",
        "dataClassification",
        "timeoutSeconds",
        "retryExpectation",
        "readinessMethod",
        "testDoubleRef",
        "availabilityRequirement",
        "endpointRef",
        "requiredSecretRefs"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9._-]+$"
        },
        "classification": {
          "enum": ["internal", "external"]
        },
        "direction": {
          "enum": ["inbound", "outbound", "bidirectional"]
        },
        "owningModule": {
          "type": "string",
          "minLength": 1
        },
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "consumer": {
          "type": "string",
          "minLength": 1
        },
        "protocol": {
          "enum": [
            "http",
            "https",
            "grpc",
            "graphql",
            "websocket",
            "oidc",
            "database",
            "message",
            "file",
            "other"
          ]
        },
        "contractVersion": {
          "type": "string",
          "minLength": 1
        },
        "contractRef": {
          "type": "string",
          "minLength": 1
        },
        "authenticationMode": {
          "type": "string",
          "minLength": 1
        },
        "dataClassification": {
          "enum": ["public", "internal", "confidential", "restricted"]
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        },
        "retryExpectation": {
          "enum": ["none", "bounded", "provider_managed"]
        },
        "readinessMethod": {
          "type": "string",
          "minLength": 1
        },
        "testDoubleRef": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^testdouble://"
            },
            {
              "type": "null"
            }
          ]
        },
        "availabilityRequirement": {
          "enum": ["optional", "required_for_gate", "required_for_functional"]
        },
        "endpointRef": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^env://"
            },
            {
              "type": "null"
            }
          ]
        },
        "requiredSecretRefs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^secret://"
          }
        }
      }
    }
  }
}
