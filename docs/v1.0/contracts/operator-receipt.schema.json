{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdlc.dev/contracts/v1alpha1/operator-receipt.schema.json",
  "title": "OperatorReceipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "api_version",
    "receipt_id",
    "action",
    "project_ref",
    "task_id",
    "task_version",
    "subject_type",
    "subject_ref",
    "subject_hash",
    "revision_vector_ref",
    "revision_vector_hash",
    "actor_id",
    "actor_roles",
    "authn_level",
    "issued_at",
    "nonce",
    "previous_receipt_hash",
    "signature"
  ],
  "properties": {
    "api_version": {
      "const": "sdlc.dev/operator-receipt/v1alpha1"
    },
    "receipt_id": {
      "type": "string",
      "pattern": "^(APR|RCP)-[A-Za-z0-9._-]+$"
    },
    "action": {
      "enum": [
        "approve_spec",
        "accept_review",
        "approve_delivery",
        "suspend_task",
        "resume_task",
        "reconcile_revision",
        "cancel_task",
        "cancel_operation",
        "environment_bind",
        "framework_pack_bind",
        "policy_bind"
      ]
    },
    "project_ref": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^TASK-[A-Za-z0-9._-]+$"
        },
        {
          "type": "null"
        }
      ]
    },
    "task_version": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "subject_type": {
      "type": "string",
      "minLength": 1
    },
    "subject_ref": {
      "type": "string",
      "pattern": "^sdlc://"
    },
    "subject_hash": {
      "$ref": "#/$defs/sha256"
    },
    "revision_vector_ref": {
      "type": "string",
      "pattern": "^sdlc://"
    },
    "revision_vector_hash": {
      "$ref": "#/$defs/sha256"
    },
    "actor_id": {
      "type": "string",
      "minLength": 1
    },
    "actor_roles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "authn_level": {
      "const": "local_unverified"
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "nonce": {
      "type": "string",
      "minLength": 16
    },
    "previous_receipt_hash": {
      "oneOf": [
        {
          "$ref": "#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "signature": {
      "type": "null"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
