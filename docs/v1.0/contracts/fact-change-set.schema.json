{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdlc.dev/contracts/v1alpha1/fact-change-set.schema.json",
  "title": "FactChangeSet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "base_facts_revision",
    "proposal_hash",
    "operations",
    "expected_result_facts_revision",
    "validation_report_ref"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "base_facts_revision": {
      "$ref": "#/$defs/sha256"
    },
    "proposal_hash": {
      "$ref": "#/$defs/sha256"
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {"$ref": "#/$defs/create"},
          {"$ref": "#/$defs/replace"},
          {"$ref": "#/$defs/delete"}
        ]
      }
    },
    "expected_result_facts_revision": {
      "$ref": "#/$defs/sha256"
    },
    "validation_report_ref": {
      "$ref": "#/$defs/sdlcRef"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "sdlcRef": {
      "type": "string",
      "pattern": "^sdlc://"
    },
    "path": {
      "type": "string",
      "pattern": "^docs/sdlc/(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\\\u0000]+$"
    },
    "create": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "op",
        "path",
        "content_ref",
        "content_hash",
        "media_type",
        "encoding",
        "line_endings",
        "expected_result_hash"
      ],
      "properties": {
        "op": {"const": "create"},
        "path": {"$ref": "#/$defs/path"},
        "content_ref": {"$ref": "#/$defs/sdlcRef"},
        "content_hash": {"$ref": "#/$defs/sha256"},
        "media_type": {"enum": ["text/markdown", "application/json", "application/yaml"]},
        "encoding": {"const": "utf-8"},
        "line_endings": {"const": "lf"},
        "expected_result_hash": {"$ref": "#/$defs/sha256"}
      }
    },
    "replace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "op",
        "path",
        "expected_base_hash",
        "content_ref",
        "content_hash",
        "media_type",
        "encoding",
        "line_endings",
        "expected_result_hash"
      ],
      "properties": {
        "op": {"const": "replace"},
        "path": {"$ref": "#/$defs/path"},
        "expected_base_hash": {"$ref": "#/$defs/sha256"},
        "content_ref": {"$ref": "#/$defs/sdlcRef"},
        "content_hash": {"$ref": "#/$defs/sha256"},
        "media_type": {"enum": ["text/markdown", "application/json", "application/yaml"]},
        "encoding": {"const": "utf-8"},
        "line_endings": {"const": "lf"},
        "expected_result_hash": {"$ref": "#/$defs/sha256"}
      }
    },
    "delete": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "path", "expected_base_hash"],
      "properties": {
        "op": {"const": "delete"},
        "path": {"$ref": "#/$defs/path"},
        "expected_base_hash": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
