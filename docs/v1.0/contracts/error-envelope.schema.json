{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdlc.dev/contracts/v1alpha1/error-envelope.schema.json",
  "title": "ErrorEnvelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "code",
    "category",
    "message",
    "retryable",
    "trace_id",
    "correlation_id",
    "details_ref",
    "expected_version",
    "current_version",
    "remediation"
  ],
  "properties": {
    "code": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
    },
    "category": {
      "enum": [
        "validation",
        "conflict",
        "product",
        "spec",
        "test_contract",
        "environment",
        "policy",
        "infrastructure",
        "revision",
        "budget",
        "storage",
        "authorization",
        "unknown"
      ]
    },
    "message": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "retryable": {
      "type": "boolean"
    },
    "trace_id": {
      "type": "string",
      "minLength": 1
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1
    },
    "details_ref": {
      "type": ["string", "null"],
      "pattern": "^sdlc://"
    },
    "expected_version": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "current_version": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "remediation": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    }
  }
}
