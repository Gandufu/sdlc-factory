{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdlc.dev/contracts/v1alpha1/execution-plan.schema.json",
  "title": "ExecutionPlan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "api_version",
    "plan_id",
    "operation_id",
    "capability",
    "pack",
    "revision_vector_hash",
    "gate_input_manifest_ref",
    "executable",
    "argv",
    "cwd",
    "inputs",
    "outputs",
    "side_effect_class",
    "writable_paths",
    "protected_paths",
    "environment_allowlist",
    "required_secret_refs",
    "network_policy",
    "resource_limits",
    "timeout_seconds",
    "cancellation",
    "readiness",
    "cleanup",
    "parser",
    "required_enforcement"
  ],
  "properties": {
    "api_version": {
      "const": "sdlc.dev/execution-plan/v1alpha1"
    },
    "plan_id": {
      "type": "string",
      "pattern": "^PLAN-[A-Za-z0-9._-]+$"
    },
    "operation_id": {
      "type": "string",
      "pattern": "^OP-[A-Za-z0-9._-]+$"
    },
    "capability": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:\\.[a-z][a-z0-9]*)+$"
    },
    "pack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "digest"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "revision_vector_hash": {
      "$ref": "#/$defs/sha256"
    },
    "gate_input_manifest_ref": {
      "$ref": "#/$defs/sdlcRef"
    },
    "executable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["toolchain_id", "requested_name"],
      "properties": {
        "toolchain_id": {
          "type": "string",
          "minLength": 1
        },
        "requested_name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "argv": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "cwd": {
      "$ref": "#/$defs/workspacePath"
    },
    "inputs": {
      "$ref": "#/$defs/pathList"
    },
    "outputs": {
      "$ref": "#/$defs/pathList"
    },
    "side_effect_class": {
      "enum": ["read_only", "workspace_write", "background_process", "package_output"]
    },
    "writable_paths": {
      "$ref": "#/$defs/pathList"
    },
    "protected_paths": {
      "$ref": "#/$defs/pathList"
    },
    "environment_allowlist": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
      }
    },
    "required_secret_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^secret://"
      }
    },
    "network_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "endpoint_refs"],
      "properties": {
        "mode": {
          "enum": ["none", "declared_endpoints", "unrestricted"]
        },
        "endpoint_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^env://"
          }
        }
      }
    },
    "resource_limits": {
      "$ref": "#/$defs/resourceLimits"
    },
    "timeout_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 86400
    },
    "cancellation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["grace_seconds", "force_after_seconds"],
      "properties": {
        "grace_seconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 600
        },
        "force_after_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1200
        }
      }
    },
    "readiness": {
      "oneOf": [
        {
          "$ref": "#/$defs/lifecycleStep"
        },
        {
          "type": "null"
        }
      ]
    },
    "cleanup": {
      "oneOf": [
        {
          "$ref": "#/$defs/lifecycleStep"
        },
        {
          "type": "null"
        }
      ]
    },
    "parser": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "digest"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "required_enforcement": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "#/$defs/runnerControl"
      },
      "additionalProperties": {
        "enum": ["enforced", "observed", "not_enforced"]
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "sdlcRef": {
      "type": "string",
      "pattern": "^sdlc://"
    },
    "runnerControl": {
      "enum": [
        "executable_resolution",
        "indirect_shell",
        "process_tree",
        "timeout_and_cancel",
        "stdout_stderr_limit",
        "environment_allowlist",
        "cwd_and_declared_paths",
        "protected_path_mutation",
        "cpu_memory_process_count",
        "temporary_disk_usage",
        "network_allowlist",
        "hostile_code_isolation"
      ]
    },
    "workspacePath": {
      "type": "string",
      "minLength": 1,
      "not": {
        "pattern": "(^/)|(^[A-Za-z]:)|(^\\\\\\\\)|(^|/)\\.\\.(/|$)|\\u0000"
      }
    },
    "pathList": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/workspacePath"
      }
    },
    "resourceLimits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cpu_percent",
        "memory_bytes",
        "disk_bytes",
        "process_count",
        "log_bytes"
      ],
      "properties": {
        "cpu_percent": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "memory_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "disk_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "process_count": {
          "type": "integer",
          "minimum": 1
        },
        "log_bytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "lifecycleStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "timeout_seconds", "parameters"],
      "properties": {
        "type": {
          "enum": ["http", "tcp", "process", "file", "capability"]
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        },
        "parameters": {
          "type": "object"
        }
      }
    }
  }
}
