{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdlc.factory/contracts/v1/execution-plan.schema.json",
  "title": "ExecutionPlan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "planId",
    "operationId",
    "moduleId",
    "capability",
    "argv",
    "cwd",
    "environment",
    "timeoutSeconds",
    "expectedOutputs"
  ],
  "properties": {
    "apiVersion": {
      "const": "sdlc.factory/v1"
    },
    "planId": {
      "$ref": "#/$defs/id"
    },
    "operationId": {
      "$ref": "#/$defs/id"
    },
    "moduleId": {
      "$ref": "#/$defs/id"
    },
    "capability": {
      "$ref": "#/$defs/capability"
    },
    "argv": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "cwd": {
      "type": "string",
      "minLength": 1
    },
    "environment": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "timeoutSeconds": {
      "type": "integer",
      "minimum": 1
    },
    "expectedOutputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind"
        ],
        "properties": {
          "kind": {
            "enum": [
              "log",
              "test_report",
              "build_artifact",
              "runtime_handle",
              "diagnostic"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,127}$"
    },
    "capability": {
      "enum": [
        "project.inspect",
        "dependencies.restore",
        "code.check",
        "build.compile",
        "package.build",
        "app.start",
        "app.ready",
        "app.stop",
        "test.run"
      ]
    }
  }
}
