{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdlc.dev/contracts/v1alpha1/environment-binding.schema.json",
  "title": "EnvironmentBinding",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "metadata",
    "ownership",
    "bindings",
    "readiness",
    "testData"
  ],
  "properties": {
    "apiVersion": {
      "const": "sdlc.dev/environment-binding/v1alpha1"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "revision", "digest"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9._-]+$"
        },
        "type": {
          "enum": ["local", "dev", "sit", "uat", "production_like"]
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "digest": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "ownership": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "changePath"],
      "properties": {
        "owner": {
          "const": "Operator"
        },
        "changePath": {
          "const": "operator_receipt"
        }
      }
    },
    "bindings": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/binding"
      },
      "propertyNames": {
        "pattern": "^[a-z][A-Za-z0-9_.-]+$"
      }
    },
    "readiness": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "interfaceId",
          "type",
          "path",
          "timeoutSeconds"
        ],
        "properties": {
          "interfaceId": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9._-]+$"
          },
          "type": {
            "enum": ["http", "tcp", "oidc_discovery", "custom"]
          },
          "path": {
            "type": "string"
          },
          "timeoutSeconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3600
          }
        }
      }
    },
    "testData": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profileRef"],
      "properties": {
        "profileRef": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^testdata://"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "binding": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["value", "valueVersion"],
          "properties": {
            "value": {
              "type": [
                "string",
                "integer",
                "boolean"
              ]
            },
            "valueVersion": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "secretRef",
            "providerIdentity",
            "secretVersion"
          ],
          "properties": {
            "secretRef": {
              "type": "string",
              "pattern": "^secret://"
            },
            "providerIdentity": {
              "type": "string",
              "minLength": 1
            },
            "secretVersion": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    }
  }
}
