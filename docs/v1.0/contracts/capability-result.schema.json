{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdlc.factory/contracts/v1/capability-result.schema.json",
  "title": "CapabilityResult",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "operationId",
    "moduleId",
    "capability",
    "status",
    "exitCode",
    "diagnostics",
    "evidenceRefs"
  ],
  "properties": {
    "apiVersion": {
      "const": "sdlc.factory/v1"
    },
    "operationId": {
      "$ref": "#/$defs/id"
    },
    "moduleId": {
      "$ref": "#/$defs/id"
    },
    "capability": {
      "$ref": "#/$defs/capability"
    },
    "status": {
      "enum": [
        "succeeded",
        "failed",
        "cancelled",
        "interrupted"
      ]
    },
    "exitCode": {
      "type": [
        "integer",
        "null"
      ]
    },
    "runtimeHandle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "pid": {
          "type": "integer",
          "minimum": 1
        },
        "metadata": {
          "type": "object"
        }
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "category",
          "code",
          "message"
        ],
        "properties": {
          "category": {
            "enum": [
              "product",
              "specification",
              "test_contract",
              "infrastructure",
              "environment"
            ]
          },
          "code": {
            "type": "string",
            "minLength": 1
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "sourceRef": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "evidenceRefs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidenceRef"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,127}$"
    },
    "capability": {
      "enum": [
        "project.inspect",
        "dependencies.restore",
        "code.check",
        "build.compile",
        "package.build",
        "app.start",
        "app.ready",
        "app.stop",
        "test.run"
      ]
    },
    "evidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "path",
        "sha256"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": [
            "stdout",
            "stderr",
            "test_report",
            "build_artifact",
            "diagnostic",
            "review_decision"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  }
}
