<?xml version="1.0" encoding="UTF-8"?>
<!--
  factory-app：Spring Boot 应用装配层
  唯一允许引入 Web、数据库驱动与 Flyway 的模块；
  REST + SSE 对外，loopback 绑定，Electron 壳负责进程生命周期。
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.sdlc.factory</groupId>
        <artifactId>factory-build</artifactId>
        <version>1.2.0-SNAPSHOT</version>
    </parent>

    <artifactId>factory-app</artifactId>
    <name>Factory Application</name>

    <dependencies>
        <dependency>
            <groupId>dev.sdlc.factory</groupId>
            <artifactId>factory-lifecycle</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.sdlc.factory</groupId>
            <artifactId>factory-orchestration</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.sdlc.factory</groupId>
            <artifactId>factory-runner</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.sdlc.factory</groupId>
            <artifactId>factory-gate</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.sdlc.factory</groupId>
            <artifactId>factory-persistence</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- PostgreSQL 是 v1.2 唯一权威关系数据库，不提供 H2 双轨 -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 把 contracts/ddl 下的唯一 DDL 事实源复制进 classpath，
                 保证 Flyway 迁移文件不在 Git 中出现第二份 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <executions>
                    <execution>
                        <id>copy-contract-ddl</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.outputDirectory}/db/migration</outputDirectory>
                            <resources>
                                <resource>
                            <!-- factory-app 位于 control-plane 下两级，DDL 唯一事实源在仓库根 contracts/ddl。 -->
                            <directory>${project.basedir}/../../contracts/ddl</directory>
                                    <includes>
                                        <include>V*.sql</include>
                                    </includes>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
