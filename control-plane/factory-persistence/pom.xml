<?xml version="1.0" encoding="UTF-8"?>
<!--
  factory-persistence：数据访问层（MyBatis-Plus）
  - 简单 CRUD 使用 MyBatis-Plus BaseMapper 内置能力；
  - 复杂多表 SQL 一律放在 resources/mapper/*.xml（XML Mapper），
    与 v1.2“显式 SQL、不以 ORM 回调隐式推进生命周期”的要求一致。
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.sdlc.factory</groupId>
        <artifactId>factory-build</artifactId>
        <version>1.2.0-SNAPSHOT</version>
    </parent>

    <artifactId>factory-persistence</artifactId>
    <name>Factory Persistence</name>

    <dependencies>
        <dependency>
            <groupId>dev.sdlc.factory</groupId>
            <artifactId>factory-contracts</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.sdlc.factory</groupId>
            <artifactId>factory-lifecycle</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.sdlc.factory</groupId>
            <artifactId>factory-gate</artifactId>
        </dependency>
        <!-- MyBatis-Plus：Boot3 starter 坐标，Boot 4 兼容性以调研结论为准 -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
