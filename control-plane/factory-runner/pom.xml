<?xml version="1.0" encoding="UTF-8"?>
<!--
  factory-runner：Windows 原生受控子进程执行器
  统一工作目录、环境、超时、取消、完整进程树终止与输出脱敏入口。
  命令只允许来自已发布的 TemplateRegistration / ProjectRuntimeAdapter（由调用方保证）。
  本模块为纯 Java 模块，不依赖 Spring。
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.sdlc.factory</groupId>
        <artifactId>factory-build</artifactId>
        <version>1.2.0-SNAPSHOT</version>
    </parent>

    <artifactId>factory-runner</artifactId>
    <name>Factory Runner</name>

    <dependencies>
        <dependency>
            <groupId>dev.sdlc.factory</groupId>
            <artifactId>factory-contracts</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
