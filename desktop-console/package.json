{
  "name": "sdlc-factory-desktop-console",
  "productName": "SDLC Factory",
  "version": "0.1.0",
  "description": "SDLC Factory Electron desktop console.",
  "author": "SDLC Factory Contributors",
  "private": true,
  "main": ".vite/build/main.js",
  "scripts": {
    "start": "electron-forge start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
