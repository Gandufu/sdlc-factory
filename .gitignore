# Superpowers brainstorming runtime state may contain local access keys,
# process IDs, ports, logs, and machine-specific absolute paths.
.superpowers/brainstorm/.last-port
.superpowers/brainstorm/.last-token
.superpowers/brainstorm/**/state/

# Local Node.js install and generated Plugin bundles.
**/node_modules/
packages/opencode-plugin/dist/

# Local render and inspection artifacts.
/tmp/
