{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdlc-factory.local/schemas/v1.2/template-binding.schema.json",
  "title": "TemplateBinding",
  "type": "object",
  "additionalProperties": false,
  "required": ["project_id", "template_id", "template_version", "template_digest", "bound_at", "binding_reason"],
  "properties": {
    "project_id": { "type": "string", "minLength": 1 },
    "template_id": { "type": "string", "minLength": 1 },
    "template_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "template_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "bound_at": { "type": "string", "format": "date-time" },
    "binding_reason": { "type": "string", "minLength": 1 }
  }
}
