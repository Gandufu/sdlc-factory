{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdlc-factory.local/schemas/v1.2/evidence.schema.json",
  "title": "Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["evidence_id", "run_id", "evidence_type", "media_type", "storage_ref", "content_hash", "byte_length", "source", "sanitized", "produced_at"],
  "properties": {
    "evidence_id": { "type": "string", "pattern": "^EVD-[A-Z0-9][A-Z0-9-]*$" },
    "run_id": { "type": "string", "pattern": "^RUN-[A-Z0-9][A-Z0-9-]*$" },
    "evidence_type": { "enum": ["COMMAND_OUTPUT", "TEST_RESULT", "DIFF", "FILE", "SCREENSHOT", "TRACE", "REPORT"] },
    "media_type": { "type": "string", "minLength": 1 },
    "storage_ref": { "type": "string", "minLength": 1 },
    "content_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "byte_length": { "type": "integer", "minimum": 0 },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "source_id"],
      "properties": {
        "kind": { "enum": ["HOST", "RUNNER", "FACTORY", "OPERATOR"] },
        "source_id": { "type": "string", "minLength": 1 },
        "command_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      }
    },
    "sanitized": { "const": true },
    "produced_at": { "type": "string", "format": "date-time" }
  }
}
