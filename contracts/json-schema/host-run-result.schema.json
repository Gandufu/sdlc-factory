{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdlc-factory.local/schemas/v1.2/host-run-result.schema.json",
  "title": "HostRunResult",
  "type": "object",
  "additionalProperties": false,
  "required": ["result_id", "run_id", "invocation_id", "host_session_id", "status", "usage", "completed_at"],
  "properties": {
    "result_id": { "type": "string", "pattern": "^HRS-[A-Z0-9][A-Z0-9-]*$" },
    "run_id": { "type": "string", "pattern": "^RUN-[A-Z0-9][A-Z0-9-]*$" },
    "invocation_id": { "type": "string", "pattern": "^INV-[A-Z0-9][A-Z0-9-]*$" },
    "host_session_id": { "type": "string", "minLength": 1 },
    "status": { "enum": ["SUCCEEDED", "FAILED", "CANCELLED", "TIMED_OUT", "BLOCKED"] },
    "handoff_ref": { "type": "string", "minLength": 1 },
    "error_ref": { "type": "string", "minLength": 1 },
    "usage": {
      "type": "object", "additionalProperties": false,
      "required": ["input_tokens", "output_tokens", "cost_usd", "host_calls"],
      "properties": {
        "input_tokens": { "type": "integer", "minimum": 0 },
        "output_tokens": { "type": "integer", "minimum": 0 },
        "cost_usd": { "type": "number", "minimum": 0 },
        "host_calls": { "type": "integer", "minimum": 0 }
      }
    },
    "completed_at": { "type": "string", "format": "date-time" }
  },
  "allOf": [
    { "if": { "properties": { "status": { "const": "SUCCEEDED" } }, "required": ["status"] }, "then": { "required": ["handoff_ref"] } },
    { "if": { "properties": { "status": { "enum": ["FAILED", "TIMED_OUT", "BLOCKED"] } }, "required": ["status"] }, "then": { "required": ["error_ref"] } }
  ]
}
