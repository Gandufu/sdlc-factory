{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdlc-factory.local/schemas/v1.2/system-acceptance-baseline.schema.json",
  "title": "SystemAcceptanceBaseline",
  "type": "object",
  "additionalProperties": false,
  "required": ["baseline_id", "system_acceptance_id", "project_id", "release_scope_id", "execution_plan_version", "participating_cu_baselines", "interface_version_bindings", "environment_binding_ref", "evidence_refs", "review_record_id", "content_hash", "validity_status", "created_at"],
  "properties": {
    "baseline_id": { "type": "string", "minLength": 1 },
    "system_acceptance_id": { "type": "string", "pattern": "^SA-[A-Z0-9][A-Z0-9-]*$" },
    "project_id": { "type": "string", "minLength": 1 },
    "release_scope_id": { "type": "string", "minLength": 1 },
    "execution_plan_version": { "type": "integer", "minimum": 1 },
    "participating_cu_baselines": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/cuBaselineBinding" } },
    "interface_version_bindings": { "type": "array", "items": { "$ref": "#/$defs/versionBinding" }, "uniqueItems": true },
    "environment_binding_ref": { "type": "string", "minLength": 1 },
    "evidence_refs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "review_record_id": { "type": "string", "minLength": 1 },
    "content_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "signature_ref": { "type": ["string", "null"] },
    "validity_status": { "enum": ["VALID", "STALE"] },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "cuBaselineBinding": {
      "type": "object", "additionalProperties": false,
      "required": ["cu_id", "code_baseline_id", "test_baseline_id"],
      "properties": { "cu_id": { "type": "string", "minLength": 1 }, "code_baseline_id": { "type": "string", "minLength": 1 }, "test_baseline_id": { "type": "string", "minLength": 1 } }
    },
    "versionBinding": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "version"],
      "properties": { "id": { "type": "string", "minLength": 1 }, "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" } }
    }
  }
}
