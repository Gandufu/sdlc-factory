{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdlc-factory.local/schemas/v1.2/factory-run-budget.schema.json",
  "title": "FactoryRunBudget",
  "type": "object",
  "additionalProperties": false,
  "required": ["max_concurrent_runs", "per_project_quota", "priority_policy"],
  "properties": {
    "max_concurrent_runs": { "const": 1 },
    "per_project_quota": { "const": 1 },
    "priority_policy": { "const": "DEPENDENCY_THEN_BUSINESS_PRIORITY_THEN_FIFO" }
  }
}
