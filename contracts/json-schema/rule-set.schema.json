{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdlc-factory.local/schemas/v1.2/rule-set.schema.json",
  "title": "RuleSet",
  "type": "object",
  "additionalProperties": false,
  "required": ["ruleset_id", "version", "applicable_stage", "stack_tags", "content_ref", "content_hash", "status", "created_at"],
  "properties": {
    "ruleset_id": { "type": "string", "pattern": "^RS-[A-Z0-9][A-Z0-9-]*$" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "applicable_stage": { "enum": ["REQUIREMENT", "DESIGN", "CODING", "TESTING", "SYSTEM_ACCEPTANCE"] },
    "stack_tags": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "content_ref": { "type": "string", "minLength": 1 },
    "content_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "status": { "enum": ["DRAFT", "ACTIVE", "DEPRECATED"] },
    "published_by": { "type": "string", "minLength": 1 },
    "published_at": { "type": "string", "format": "date-time" },
    "publication_reason": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "allOf": [{ "if": { "properties": { "status": { "enum": ["ACTIVE", "DEPRECATED"] } }, "required": ["status"] }, "then": { "required": ["published_by", "published_at", "publication_reason"] } }]
}
