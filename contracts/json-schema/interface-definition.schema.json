{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdlc-factory.local/schemas/v1.2/interface-definition.schema.json",
  "title": "InterfaceDefinition",
  "type": "object",
  "additionalProperties": false,
  "required": ["interface_id", "classification", "provider", "consumers", "owning_csci_id", "related_cu_ids", "protocol", "operations", "request_schema_ref", "response_schema_ref", "authentication", "error_model", "timeout", "availability_requirement", "version", "compatibility_policy", "environment_bindings", "baseline_status", "status", "created_at"],
  "properties": {
    "interface_id": { "type": "string", "pattern": "^IF-[A-Z0-9][A-Z0-9-]*$" },
    "classification": { "enum": ["INTRA_CSCI", "INTER_CSCI_INTERNAL", "EXTERNAL_SYSTEM"] },
    "provider": { "type": "string", "minLength": 1 },
    "consumers": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "owning_csci_id": { "type": "string", "minLength": 1 },
    "related_cu_ids": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "protocol": { "type": "string", "minLength": 1 },
    "operations": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1, "uniqueItems": true },
    "request_schema_ref": { "type": ["string", "null"] },
    "response_schema_ref": { "type": ["string", "null"] },
    "authentication": { "type": "string", "minLength": 1 },
    "error_model": { "type": "string", "minLength": 1 },
    "timeout": { "type": "integer", "minimum": 1, "description": "Milliseconds" },
    "availability_requirement": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "compatibility_policy": { "enum": ["BACKWARD", "FORWARD", "FULL", "NONE"] },
    "environment_bindings": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "baseline_status": { "enum": ["UNBASELINED", "BASELINED", "STALE"] },
    "status": { "enum": ["DRAFT", "PUBLISHED", "DEPRECATED"] },
    "published_from_design_baseline_id": { "type": ["string", "null"] },
    "superseded_by": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["interface_id", "version"],
          "properties": {
            "interface_id": { "type": "string", "pattern": "^IF-[A-Z0-9][A-Z0-9-]*$" },
            "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" }
          }
        }
      ]
    },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "allOf": [
    { "if": { "properties": { "status": { "const": "PUBLISHED" } }, "required": ["status"] }, "then": { "required": ["published_from_design_baseline_id"], "properties": { "published_from_design_baseline_id": { "type": "string", "minLength": 1 } } } },
    { "if": { "properties": { "status": { "const": "DEPRECATED" } }, "required": ["status"] }, "then": { "required": ["superseded_by"], "properties": { "superseded_by": { "type": "object" } } } }
  ]
}
