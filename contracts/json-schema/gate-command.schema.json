{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdlc-factory.local/schemas/v1.2/gate-command.schema.json",
  "title": "GateCommand",
  "type": "object",
  "additionalProperties": false,
  "required": ["command_id", "idempotency_key", "expected_version", "actor", "scope_type", "scope_id", "stage_type", "action", "candidate_ref", "evidence_refs", "issued_at"],
  "properties": {
    "command_id": { "type": "string", "pattern": "^GCM-[A-Z0-9][A-Z0-9-]*$" },
    "idempotency_key": { "type": "string", "minLength": 1 },
    "expected_version": { "type": "integer", "minimum": 0 },
    "actor": { "type": "string", "minLength": 1 },
    "scope_type": { "enum": ["PROJECT", "CAPABILITY_UNIT"] },
    "scope_id": { "type": "string", "minLength": 1 },
    "stage_type": { "enum": ["INITIALIZATION", "REQUIREMENT", "DESIGN", "CODING", "TESTING", "SYSTEM_ACCEPTANCE"] },
    "action": { "enum": ["APPROVE", "REQUEST_CHANGES"] },
    "candidate_ref": { "type": "string", "minLength": 1 },
    "stage_submission_ref": { "type": "string", "pattern": "^SUB-[A-Z0-9][A-Z0-9-]*$" },
    "evidence_refs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "comments": { "type": "string" },
    "issued_at": { "type": "string", "format": "date-time" }
  },
  "allOf": [
    {
      "if": { "properties": { "stage_type": { "enum": ["REQUIREMENT", "DESIGN"] } }, "required": ["stage_type"] },
      "then": { "required": ["stage_submission_ref"] }
    }
  ]
}
