{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdlc-factory.local/schemas/v1.2/handoff.schema.json",
  "title": "Handoff",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_version", "handoff_id", "run_id", "role", "summary", "observations", "declared_changed_paths", "validations", "open_issues", "submitted_at"],
  "properties": {
    "protocol_version": { "const": "1.0" },
    "handoff_id": { "type": "string", "pattern": "^HND-[A-Z0-9][A-Z0-9-]*$" },
    "run_id": { "type": "string", "pattern": "^RUN-[A-Z0-9][A-Z0-9-]*$" },
    "slice_id": { "type": "string", "minLength": 1 },
    "role": { "enum": ["REQUIREMENT", "DESIGN", "CODER", "TESTER", "REVIEWER_ASSISTANT", "SCRUTINY_VALIDATOR", "USER_TESTING_VALIDATOR"] },
    "summary": { "type": "string", "minLength": 1 },
    "observations": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "declared_changed_paths": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "validations": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "outcome", "evidence_refs"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "outcome": { "enum": ["PASSED", "FAILED", "SKIPPED", "BLOCKED"] },
          "evidence_refs": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "open_issues": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "requested_follow_up": { "type": "string", "minLength": 1 },
    "submitted_at": { "type": "string", "format": "date-time" }
  }
}
