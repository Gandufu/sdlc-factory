{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdlc-factory.local/schemas/v1.2/run-request.schema.json",
  "title": "RunRequest",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_version", "run_id", "attempt_id", "project_id", "stage", "objective", "baseline_refs", "agent_definition_ref", "prompt_template_ref", "rule_set_ref", "budget", "idempotency_key", "requested_at"],
  "properties": {
    "protocol_version": { "const": "1.0" },
    "run_id": { "type": "string", "pattern": "^RUN-[A-Z0-9][A-Z0-9-]*$" },
    "attempt_id": { "type": "string", "pattern": "^ATT-[A-Z0-9][A-Z0-9-]*$" },
    "project_id": { "type": "string", "pattern": "^PRJ-[A-Z0-9][A-Z0-9-]*$" },
    "csci_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "cu_id": { "type": "string", "minLength": 1 },
    "stage": { "enum": ["INITIALIZATION", "REQUIREMENT", "DESIGN", "CODING", "TESTING", "SYSTEM_ACCEPTANCE"] },
    "slice_id": { "type": "string", "minLength": 1 },
    "objective": { "type": "string", "minLength": 1 },
    "baseline_refs": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/versionedRef" } },
    "reference_bindings": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/versionedRef" } },
    "environment_binding_ref": { "$ref": "#/$defs/versionedRef" },
    "agent_definition_ref": { "$ref": "#/$defs/versionedRef" },
    "prompt_template_ref": { "$ref": "#/$defs/versionedRef" },
    "rule_set_ref": { "$ref": "#/$defs/versionedRef" },
    "template_binding_ref": { "$ref": "#/$defs/versionedRef" },
    "budget": {
      "type": "object", "additionalProperties": false,
      "required": ["max_duration_ms", "max_host_calls", "max_output_tokens", "max_cost_usd"],
      "properties": {
        "max_duration_ms": { "type": "integer", "minimum": 1 },
        "max_host_calls": { "type": "integer", "minimum": 1 },
        "max_output_tokens": { "type": "integer", "minimum": 1 },
        "max_cost_usd": { "type": "number", "minimum": 0 },
        "max_validation_rounds": { "type": "integer", "minimum": 1 }
      }
    },
    "idempotency_key": { "type": "string", "minLength": 1 },
    "requested_at": { "type": "string", "format": "date-time" }
  },
  "allOf": [
    {
      "if": { "properties": { "stage": { "const": "INITIALIZATION" } }, "required": ["stage"] },
      "then": { "properties": { "baseline_refs": { "type": "array", "maxItems": 0 } } },
      "else": { "properties": { "baseline_refs": { "type": "array", "minItems": 1 } } }
    }
  ],
  "$defs": {
    "versionedRef": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "version", "content_hash"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
        "content_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      }
    }
  }
}
