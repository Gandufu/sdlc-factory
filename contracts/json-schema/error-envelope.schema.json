{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdlc-factory.local/schemas/v1.2/error-envelope.schema.json",
  "title": "ErrorEnvelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["error_id", "run_id", "source", "category", "code", "message", "retryable", "fingerprint", "sanitized", "occurred_at"],
  "properties": {
    "error_id": { "type": "string", "pattern": "^ERR-[A-Z0-9][A-Z0-9-]*$" },
    "run_id": { "type": "string", "pattern": "^RUN-[A-Z0-9][A-Z0-9-]*$" },
    "source": { "enum": ["FACTORY", "HOST_ADAPTER", "HOST", "RUNNER", "TOOL", "ENVIRONMENT"] },
    "category": { "enum": ["VALIDATION", "AUTHENTICATION", "PERMISSION", "RATE_LIMIT", "TIMEOUT", "CANCELLED", "CONFLICT", "UNAVAILABLE", "STRUCTURED_OUTPUT", "INTERNAL"] },
    "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
    "message": { "type": "string", "minLength": 1 },
    "retryable": { "type": "boolean" },
    "fingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "sanitized": { "const": true },
    "details": { "type": "object" },
    "occurred_at": { "type": "string", "format": "date-time" }
  }
}
