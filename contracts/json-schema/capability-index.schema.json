{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdlc-factory.local/schemas/v1.2/capability-index.schema.json",
  "title": "CapabilityIndex",
  "type": "object",
  "additionalProperties": false,
  "required": ["capability_index_id", "project_id", "run_id", "stage", "entries", "generated_at"],
  "properties": {
    "capability_index_id": { "type": "string", "pattern": "^CI-[A-Z0-9][A-Z0-9-]*$" },
    "project_id": { "type": "string", "minLength": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "stage": { "enum": ["REQUIREMENT", "DESIGN", "CODING", "TESTING", "SYSTEM_ACCEPTANCE"] },
    "entries": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/entry" } },
    "generated_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "contentHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entry_id", "kind", "name", "short_description", "source_ref", "version", "authority_class", "load_policy", "content_hash"],
      "properties": {
        "entry_id": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["INTERNAL_TOOL", "MCP_TOOL", "SKILL", "PLUGIN", "REFERENCE_SOURCE", "AUTHORITY_SOURCE"] },
        "name": { "type": "string", "minLength": 1 },
        "short_description": { "type": "string", "minLength": 1, "maxLength": 300 },
        "source_ref": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "input_hint": { "type": "string", "maxLength": 300 },
        "authority_class": { "enum": ["APPROVED_BASELINE", "REGISTERED_ASSET", "REFERENCE", "EXECUTION_CAPABILITY"] },
        "load_policy": { "enum": ["EAGER", "DEFERRED"] },
        "content_hash": { "$ref": "#/$defs/contentHash" }
      }
    }
  }
}
