<?xml version="1.0" encoding="UTF-8"?>
<!--
  factory-orchestration：Run、ExecutionSlice 与容量调度
  v1.2 单实例容量合同：max_concurrent_runs = 1，per_project_quota = 1；
  容量不足的请求进入 QUEUED_FOR_CAPACITY，不计失败、不消耗重试预算。
  本模块为纯领域模块，不依赖 Spring。
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.sdlc.factory</groupId>
        <artifactId>factory-build</artifactId>
        <version>1.2.0-SNAPSHOT</version>
    </parent>

    <artifactId>factory-orchestration</artifactId>
    <name>Factory Orchestration</name>

    <dependencies>
        <dependency>
            <groupId>dev.sdlc.factory</groupId>
            <artifactId>factory-contracts</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
