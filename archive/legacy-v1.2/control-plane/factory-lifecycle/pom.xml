<?xml version="1.0" encoding="UTF-8"?>
<!--
  factory-lifecycle：分层生命周期领域模型
  带作用域的 LifecycleStage 状态机（sealed 状态 + 模式匹配）、
  ReviewRecord（职责分离）与 Baseline（不可变基线）。
  本模块为纯领域模块，不依赖 Spring。
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.sdlc.factory</groupId>
        <artifactId>factory-build</artifactId>
        <version>1.2.0-SNAPSHOT</version>
    </parent>

    <artifactId>factory-lifecycle</artifactId>
    <name>Factory Lifecycle</name>

    <dependencies>
        <dependency>
            <groupId>dev.sdlc.factory</groupId>
            <artifactId>factory-contracts</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
