{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdlc-factory.local/schemas/v1.2/skill-definition.schema.json",
  "title": "SkillDefinition",
  "type": "object",
  "additionalProperties": false,
  "required": ["skill_id", "version", "description", "source_ref", "native_path", "applicable_stages", "load_mode", "content_hash", "status", "created_at"],
  "properties": {
    "skill_id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 64 },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "description": { "type": "string", "minLength": 1, "maxLength": 1024 },
    "source_ref": { "type": "string", "minLength": 1 },
    "native_path": { "type": "string", "pattern": "^\\.opencode/skills/[a-z0-9]+(-[a-z0-9]+)*/SKILL\\.md$" },
    "applicable_stages": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["REQUIREMENT", "DESIGN", "PLANNING", "CODING", "TESTING", "SYSTEM_ACCEPTANCE"] } },
    "load_mode": { "const": "NATIVE_ON_DEMAND" },
    "content_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "status": { "enum": ["DRAFT", "ACTIVE", "DEPRECATED"] },
    "published_by": { "type": "string", "minLength": 1 },
    "published_at": { "type": "string", "format": "date-time" },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "enum": ["ACTIVE", "DEPRECATED"] } }, "required": ["status"] },
      "then": { "required": ["published_by", "published_at"] }
    }
  ]
}
