{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdlc-factory.local/schemas/v1.2/gate-result.schema.json",
  "title": "GateResult",
  "type": "object",
  "additionalProperties": false,
  "required": ["result_id", "command_id", "outcome", "actual_version", "decided_at"],
  "properties": {
    "result_id": { "type": "string", "pattern": "^GRS-[A-Z0-9][A-Z0-9-]*$" },
    "command_id": { "type": "string", "pattern": "^GCM-[A-Z0-9][A-Z0-9-]*$" },
    "outcome": { "enum": ["APPLIED", "REJECTED", "IDEMPOTENT_REPLAY"] },
    "actual_version": { "type": "integer", "minimum": 0 },
    "review_record_ref": { "type": "string", "minLength": 1 },
    "baseline_ref": { "type": "string", "minLength": 1 },
    "error": { "$ref": "#/$defs/error" },
    "decided_at": { "type": "string", "format": "date-time" }
  },
  "allOf": [
    { "if": { "properties": { "outcome": { "const": "APPLIED" } }, "required": ["outcome"] }, "then": { "required": ["review_record_ref"] } },
    { "if": { "properties": { "outcome": { "const": "REJECTED" } }, "required": ["outcome"] }, "then": { "required": ["error"] } }
  ],
  "$defs": {
    "error": {
      "type": "object", "additionalProperties": false,
      "required": ["code", "message", "retryable"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 },
        "retryable": { "type": "boolean" }
      }
    }
  }
}
