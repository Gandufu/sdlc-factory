{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdlc-factory.local/schemas/v1.2/agent-invocation.schema.json",
  "title": "AgentInvocation",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_version", "invocation_id", "run_id", "attempt_id", "host_adapter", "objective", "context_manifest_ref", "rendered_messages", "output_contract", "created_at"],
  "properties": {
    "protocol_version": { "const": "1.0" },
    "invocation_id": { "type": "string", "pattern": "^INV-[A-Z0-9][A-Z0-9-]*$" },
    "run_id": { "type": "string", "pattern": "^RUN-[A-Z0-9][A-Z0-9-]*$" },
    "attempt_id": { "type": "string", "pattern": "^ATT-[A-Z0-9][A-Z0-9-]*$" },
    "host_adapter": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "adapter_version", "host_version"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "adapter_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
        "host_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
        "sdk_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" }
      }
    },
    "objective": { "type": "string", "minLength": 1 },
    "context_manifest_ref": { "$ref": "#/$defs/contentRef" },
    "rendered_messages": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["role", "content"],
        "properties": {
          "role": { "enum": ["SYSTEM", "USER", "ASSISTANT"] },
          "content": { "type": "string", "minLength": 1 }
        }
      }
    },
    "output_contract": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_id", "schema_version", "content_hash", "validation_retry_limit"],
      "properties": {
        "schema_id": { "type": "string", "minLength": 1 },
        "schema_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
        "content_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "validation_retry_limit": { "type": "integer", "minimum": 0, "maximum": 2 }
      }
    },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "contentRef": {
      "type": "object", "additionalProperties": false,
      "required": ["ref", "content_hash"],
      "properties": {
        "ref": { "type": "string", "minLength": 1 },
        "content_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      }
    }
  }
}
