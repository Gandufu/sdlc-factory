{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdlc-factory.local/schemas/v1.2/template-registration.schema.json",
  "title": "TemplateRegistration",
  "type": "object",
  "additionalProperties": false,
  "required": ["template_id", "version", "descriptor_ref", "digest", "status", "created_at"],
  "properties": {
    "template_id": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "descriptor_ref": { "type": "string", "minLength": 1 },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "status": { "enum": ["DRAFT", "ACTIVE", "DEPRECATED"] },
    "published_by": { "type": "string", "minLength": 1 },
    "published_at": { "type": "string", "format": "date-time" },
    "publication_reason": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "allOf": [{ "if": { "properties": { "status": { "enum": ["ACTIVE", "DEPRECATED"] } }, "required": ["status"] }, "then": { "required": ["published_by", "published_at", "publication_reason"] } }]
}
