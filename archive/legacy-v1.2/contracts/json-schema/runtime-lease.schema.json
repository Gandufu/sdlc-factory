{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdlc-factory.local/schemas/v1.2/runtime-lease.schema.json",
  "title": "RuntimeLease",
  "type": "object",
  "additionalProperties": false,
  "required": ["runtime_id", "owner_run_id", "process_handles", "endpoints", "allocated_ports", "started_at", "readiness_status", "lease_expires_at", "cleanup_token_hash"],
  "properties": {
    "runtime_id": { "type": "string", "pattern": "^RTM-[A-Z0-9][A-Z0-9-]*$" },
    "owner_run_id": { "type": "string", "pattern": "^RUN-[A-Z0-9][A-Z0-9-]*$" },
    "process_handles": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "endpoints": { "type": "array", "uniqueItems": true, "items": { "type": "string", "format": "uri" } },
    "allocated_ports": { "type": "array", "uniqueItems": true, "items": { "type": "integer", "minimum": 1, "maximum": 65535 } },
    "started_at": { "type": "string", "format": "date-time" },
    "readiness_status": { "enum": ["STARTING", "READY", "DEGRADED", "FAILED", "STOPPED"] },
    "lease_expires_at": { "type": "string", "format": "date-time" },
    "cleanup_token_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  }
}
