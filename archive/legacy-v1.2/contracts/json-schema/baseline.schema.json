{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdlc-factory.local/schemas/v1.2/baseline.schema.json",
  "title": "Baseline",
  "type": "object",
  "additionalProperties": false,
  "required": ["baseline_id", "scope_type", "scope_id", "baseline_type", "artifact_version", "content_hash", "items", "review_record_id", "reference_bindings", "validity_status", "created_at"],
  "properties": {
    "baseline_id": { "type": "string", "minLength": 1 },
    "scope_type": { "enum": ["PROJECT", "CAPABILITY_UNIT"] },
    "scope_id": { "type": "string", "minLength": 1 },
    "baseline_type": { "enum": ["INITIALIZATION", "REQUIREMENT", "DESIGN", "CODE", "TEST", "SYSTEM_ACCEPTANCE"] },
    "artifact_version": { "type": "integer", "minimum": 1 },
    "content_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "source_revision": { "type": ["string", "null"] },
    "items": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/item" } },
    "review_record_id": { "type": "string", "minLength": 1 },
    "signature_ref": { "type": ["string", "null"] },
    "reference_bindings": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "validity_status": { "enum": ["VALID", "STALE", "IMPACT_REVIEW_REQUIRED"] },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "item": {
      "type": "object", "additionalProperties": false,
      "required": ["artifact_type", "artifact_ref", "content_hash"],
      "properties": { "artifact_type": { "type": "string", "minLength": 1 }, "artifact_ref": { "type": "string", "minLength": 1 }, "content_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" } }
    }
  },
  "allOf": [
    { "if": { "properties": { "baseline_type": { "enum": ["INITIALIZATION", "REQUIREMENT", "DESIGN", "SYSTEM_ACCEPTANCE"] } }, "required": ["baseline_type"] }, "then": { "properties": { "scope_type": { "const": "PROJECT" } } } },
    { "if": { "properties": { "baseline_type": { "enum": ["CODE", "TEST"] } }, "required": ["baseline_type"] }, "then": { "properties": { "scope_type": { "const": "CAPABILITY_UNIT" } } } }
  ]
}
