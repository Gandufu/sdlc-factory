{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdlc-factory.local/schemas/v1.2/context-expansion-request.schema.json",
  "title": "ContextExpansionRequest",
  "type": "object",
  "additionalProperties": false,
  "required": ["request_id", "project_id", "run_id", "capability_index_id", "entry_id", "requested_by_agent_ref", "reason", "status", "requested_at"],
  "properties": {
    "request_id": { "type": "string", "pattern": "^CER-[A-Z0-9][A-Z0-9-]*$" },
    "project_id": { "type": "string", "minLength": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "capability_index_id": { "type": "string", "minLength": 1 },
    "entry_id": { "type": "string", "minLength": 1 },
    "requested_by_agent_ref": { "$ref": "#/$defs/versionedRef" },
    "reason": { "type": "string", "minLength": 1 },
    "status": { "enum": ["REQUESTED", "APPROVED", "DENIED", "LOADED"] },
    "decision_reason": { "type": "string", "minLength": 1 },
    "decided_at": { "type": "string", "format": "date-time" },
    "resolved_ref": { "type": "string", "minLength": 1 },
    "resolved_version": { "type": "string", "minLength": 1 },
    "loaded_content_hash": { "$ref": "#/$defs/contentHash" },
    "context_manifest_ref": { "type": "string", "minLength": 1 },
    "loaded_at": { "type": "string", "format": "date-time" },
    "requested_at": { "type": "string", "format": "date-time" }
  },
  "allOf": [
    { "if": { "properties": { "status": { "enum": ["APPROVED", "DENIED", "LOADED"] } }, "required": ["status"] }, "then": { "required": ["decision_reason", "decided_at"] } },
    { "if": { "properties": { "status": { "const": "LOADED" } }, "required": ["status"] }, "then": { "required": ["resolved_ref", "resolved_version", "loaded_content_hash", "context_manifest_ref", "loaded_at"] } }
  ],
  "$defs": {
    "contentHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "versionedRef": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "version", "content_hash"],
      "properties": { "id": { "type": "string", "minLength": 1 }, "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" }, "content_hash": { "$ref": "#/$defs/contentHash" } }
    }
  }
}
