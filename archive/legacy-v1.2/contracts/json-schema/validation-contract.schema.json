{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdlc-factory.local/schemas/v1.2/validation-contract.schema.json",
  "title": "ValidationContract",
  "type": "object",
  "additionalProperties": false,
  "required": ["validation_contract_id", "project_id", "version", "derived_from_requirement_baseline_id", "content_hash", "assertions", "status", "created_at"],
  "properties": {
    "validation_contract_id": { "type": "string", "pattern": "^VC-[A-Z0-9][A-Z0-9-]*$" },
    "project_id": { "type": "string", "minLength": 1 },
    "version": { "type": "integer", "minimum": 1 },
    "derived_from_requirement_baseline_id": { "type": "string", "minLength": 1 },
    "content_hash": { "$ref": "#/$defs/contentHash" },
    "assertions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/assertion" } },
    "status": { "enum": ["DRAFT", "FROZEN", "STALE"] },
    "frozen_by": { "type": "string", "minLength": 1 },
    "frozen_at": { "type": "string", "format": "date-time" },
    "invalidation": { "$ref": "#/$defs/invalidation" },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "allOf": [
    { "if": { "properties": { "status": { "const": "FROZEN" } }, "required": ["status"] }, "then": { "required": ["frozen_by", "frozen_at"] } },
    { "if": { "properties": { "status": { "const": "STALE" } }, "required": ["status"] }, "then": { "required": ["invalidation"] } }
  ],
  "$defs": {
    "contentHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assertion_id", "scope_type", "scope_ref", "requirement_refs", "given", "when", "then", "verification_method", "verifier_capability_ref", "required_evidence_types", "covered_by_cu_ids", "severity"],
      "properties": {
        "assertion_id": { "type": "string", "pattern": "^VAL-[A-Z0-9][A-Z0-9-]*$" },
        "scope_type": { "enum": ["PROJECT", "CAPABILITY_UNIT", "CROSS_CU"] },
        "scope_ref": { "type": "string", "minLength": 1 },
        "requirement_refs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "given": { "type": "string", "minLength": 1 },
        "when": { "type": "string", "minLength": 1 },
        "then": { "type": "string", "minLength": 1 },
        "verification_method": { "enum": ["INSPECTION", "ANALYSIS", "DEMONSTRATION", "TEST"] },
        "verifier_capability_ref": { "type": "string", "minLength": 1 },
        "required_evidence_types": { "type": "array", "minItems": 1, "items": { "enum": ["COMMAND_RESULT", "TEST_REPORT", "SCREENSHOT", "NETWORK_TRACE", "INSPECTION_RECORD", "ANALYSIS_REPORT", "DEMONSTRATION_RECORD"] }, "uniqueItems": true },
        "environment_requirement_refs": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "covered_by_cu_ids": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "severity": { "enum": ["BLOCKING", "NON_BLOCKING"] }
      },
      "allOf": [
        { "if": { "properties": { "scope_type": { "const": "CROSS_CU" } }, "required": ["scope_type"] }, "then": { "properties": { "covered_by_cu_ids": { "type": "array", "minItems": 2 } } } }
      ]
    },
    "invalidation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["invalidated_at", "reason", "trigger_ref"],
      "properties": {
        "invalidated_at": { "type": "string", "format": "date-time" },
        "reason": { "type": "string", "minLength": 1 },
        "trigger_ref": { "type": "string", "minLength": 1 }
      }
    }
  }
}
