{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdlc-factory.local/schemas/v1.2/agent-definition.schema.json",
  "title": "AgentDefinition",
  "type": "object",
  "additionalProperties": false,
  "required": ["agent_id", "version", "role", "model_binding_ref", "prompt_template_ref", "skill_refs", "capability_tags", "content_hash", "status", "created_at"],
  "properties": {
    "agent_id": { "type": "string", "pattern": "^AGT-[A-Z0-9][A-Z0-9-]*$" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "role": { "enum": ["REQUIREMENT", "DESIGN", "CODER", "TESTER", "REVIEWER_ASSISTANT", "SCRUTINY_VALIDATOR", "USER_TESTING_VALIDATOR"] },
    "model_binding_ref": { "type": "string", "minLength": 1 },
    "prompt_template_ref": { "$ref": "#/$defs/versionedRef" },
    "skill_refs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/versionedRef" } },
    "capability_tags": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "content_hash": { "$ref": "#/$defs/contentHash" },
    "status": { "enum": ["DRAFT", "ACTIVE", "DEPRECATED"] },
    "published_by": { "type": "string", "minLength": 1 },
    "published_at": { "type": "string", "format": "date-time" },
    "publication_reason": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "allOf": [{ "if": { "properties": { "status": { "enum": ["ACTIVE", "DEPRECATED"] } }, "required": ["status"] }, "then": { "required": ["published_by", "published_at", "publication_reason"] } }],
  "$defs": {
    "contentHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "versionedRef": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "version", "content_hash"],
      "properties": { "id": { "type": "string", "minLength": 1 }, "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" }, "content_hash": { "$ref": "#/$defs/contentHash" } }
    }
  }
}
