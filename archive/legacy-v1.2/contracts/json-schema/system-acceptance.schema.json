{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdlc-factory.local/schemas/v1.2/system-acceptance.schema.json",
  "title": "SystemAcceptance",
  "type": "object",
  "additionalProperties": false,
  "required": ["system_acceptance_id", "project_id", "release_scope_id", "execution_plan_version", "validation_contract_ref", "participating_cu_baselines", "validation_assertion_refs", "status", "created_at"],
  "properties": {
    "system_acceptance_id": { "type": "string", "pattern": "^SA-[A-Z0-9][A-Z0-9-]*$" },
    "project_id": { "type": "string", "minLength": 1 },
    "release_scope_id": { "type": "string", "minLength": 1 },
    "execution_plan_version": { "type": "integer", "minimum": 1 },
    "validation_contract_ref": { "$ref": "#/$defs/validationContractRef" },
    "participating_cu_baselines": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/cuBaselineBinding" } },
    "validation_assertion_refs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "system_integration_run_id": { "type": ["string", "null"] },
    "environment_binding_ref": { "type": ["string", "null"] },
    "review_record_id": { "type": ["string", "null"] },
    "status": { "enum": ["DRAFT", "RUNNING", "AWAITING_REVIEW", "APPROVED", "CHANGES_REQUESTED", "STALE"] },
    "invalidation": { "$ref": "#/$defs/invalidation" },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "allOf": [
    { "if": { "properties": { "status": { "enum": ["RUNNING", "AWAITING_REVIEW", "APPROVED", "CHANGES_REQUESTED"] } }, "required": ["status"] }, "then": { "required": ["system_integration_run_id", "environment_binding_ref"], "properties": { "system_integration_run_id": { "type": "string", "minLength": 1 }, "environment_binding_ref": { "type": "string", "minLength": 1 } } } },
    { "if": { "properties": { "status": { "const": "APPROVED" } }, "required": ["status"] }, "then": { "required": ["review_record_id"], "properties": { "review_record_id": { "type": "string", "minLength": 1 } } } },
    { "if": { "properties": { "status": { "const": "STALE" } }, "required": ["status"] }, "then": { "required": ["invalidation"] } }
  ],
  "$defs": {
    "validationContractRef": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "version", "content_hash"],
      "properties": { "id": { "type": "string", "minLength": 1 }, "version": { "type": "integer", "minimum": 1 }, "content_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" } }
    },
    "cuBaselineBinding": {
      "type": "object", "additionalProperties": false,
      "required": ["cu_id", "code_baseline_id", "test_baseline_id"],
      "properties": { "cu_id": { "type": "string", "minLength": 1 }, "code_baseline_id": { "type": "string", "minLength": 1 }, "test_baseline_id": { "type": "string", "minLength": 1 } }
    },
    "invalidation": {
      "type": "object", "additionalProperties": false,
      "required": ["invalidated_at", "reason", "trigger_ref"],
      "properties": { "invalidated_at": { "type": "string", "format": "date-time" }, "reason": { "type": "string", "minLength": 1 }, "trigger_ref": { "type": "string", "minLength": 1 } }
    }
  }
}
