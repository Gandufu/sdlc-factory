{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdlc-factory.local/schemas/v1.2/review-record.schema.json",
  "title": "ReviewRecord",
  "type": "object",
  "additionalProperties": false,
  "required": ["review_id", "scope_type", "scope_id", "stage_type", "baseline_candidate_ref", "artifact_hashes", "reviewer_identity", "reviewer_role", "separation_policy", "decision", "comments", "reviewed_at", "idempotency_key"],
  "properties": {
    "review_id": { "type": "string", "minLength": 1 },
    "scope_type": { "enum": ["PROJECT", "CAPABILITY_UNIT"] },
    "scope_id": { "type": "string", "minLength": 1 },
    "stage_type": { "enum": ["REQUIREMENT", "DESIGN", "CODING", "TESTING", "SYSTEM_ACCEPTANCE"] },
    "baseline_candidate_ref": { "type": "string", "minLength": 1 },
    "artifact_hashes": { "type": "array", "items": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }, "minItems": 1, "uniqueItems": true },
    "source_revision": { "type": ["string", "null"] },
    "reviewer_identity": { "type": "string", "minLength": 1 },
    "reviewer_role": { "enum": ["DEVELOPER", "REVIEWER", "RELEASE_MANAGER"] },
    "primary_executor_id": { "type": ["string", "null"] },
    "separation_policy": { "enum": ["ENFORCED", "SINGLE_OPERATOR_EXCEPTION"] },
    "exception_reason": { "type": ["string", "null"] },
    "decision": { "enum": ["APPROVED", "CHANGES_REQUESTED"] },
    "comments": { "type": "string" },
    "reviewed_at": { "type": "string", "format": "date-time" },
    "idempotency_key": { "type": "string", "minLength": 1 }
  },
  "allOf": [
    { "if": { "properties": { "separation_policy": { "const": "SINGLE_OPERATOR_EXCEPTION" } }, "required": ["separation_policy"] }, "then": { "required": ["primary_executor_id", "exception_reason"], "properties": { "primary_executor_id": { "type": "string", "minLength": 1 }, "exception_reason": { "type": "string", "minLength": 1 } } } },
    { "if": { "properties": { "stage_type": { "enum": ["REQUIREMENT", "DESIGN", "SYSTEM_ACCEPTANCE"] } }, "required": ["stage_type"] }, "then": { "properties": { "scope_type": { "const": "PROJECT" } } } },
    { "if": { "properties": { "stage_type": { "enum": ["CODING", "TESTING"] } }, "required": ["stage_type"] }, "then": { "required": ["primary_executor_id"], "properties": { "scope_type": { "const": "CAPABILITY_UNIT" }, "primary_executor_id": { "type": "string", "minLength": 1 } } } }
  ]
}
